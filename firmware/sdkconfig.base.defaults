# notyas firmware - shared sdkconfig defaults (all boards).
# Board-specific options (flash size only, by policy - nothing in this file
# may name a GPIO or a flash size) live in boards/<board>/sdkconfig.defaults;
# tools/build.ps1 passes both via ESP_IDF_SDKCONFIG_DEFAULTS (later file wins).

# --- Chip revision (make-or-break) -------------------------------------------
# All current dev units (Waveshare 4B and Elecrow CrowPanel Advanced) are
# rev v1.3, i.e. the pre-v3.0 engineering-sample family. IDF v5.5 defaults to
# CONFIG_ESP32P4_REV_MIN_301 (rev >= v3.1); an image built for the v3.x family
# flashes fine on v1.3 silicon but never boots (ROM banner only / boot loop,
# no output). Numbering note: ESP32P4_REV_MIN_1 is rev v0.1 and
# ESP32P4_REV_MIN_100 is rev v1.0 (REV_MIN_FULL = major*100 + minor).
# SELECTS_REV_LESS_V3 caps REV_MAX_FULL at 199, excluding v3.x chips entirely.
# Release builds for production (rev >= v3.1) hardware MUST revisit this.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# --- Reproducible builds (0.2.0-m12) -----------------------------------------
# The image must be a function of the source and nothing else. This option makes
# the IDF build pass -fmacro-prefix-map/-fdebug-prefix-map so the IDF, project,
# build, component and toolchain directories become the fixed names /IDF,
# /IDF_PROJECT, /IDF_BUILD, /COMPONENT_<NAME>_DIR and /TOOLCHAIN; it drops the
# build date and time from the app and bootloader descriptors; and it sorts the
# source, component and linker-fragment lists before they reach CMake.
#
# It lives in the SHARED defaults rather than in the release recipe on purpose.
# A reproducibility switch that is only on for release builds means the image
# that was tested on the bench is not the image that ships, and the difference
# would be invisible until someone diffed two binaries. What it cannot cover -
# the ESP-IDF version and the versions of CMake, Ninja and the cross-compiler -
# is pinned by the container instead (tools/repro/, docs/plan-0.2.0/REPRODUCIBLE.md).
#
# CONFIG_APP_PROJECT_VER is deliberately NOT set here: it would be the crate
# version written down a second time. tools/repro/build.sh generates it from
# firmware/Cargo.toml so the two can never disagree.
CONFIG_APP_REPRODUCIBLE_BUILD=y

# --- Logging -----------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- FreeRTOS / std runtime --------------------------------------------------
# Rust needs a bigger main task stack than the C default (3.5 KB). 8000 proved
# MARGINAL: the boot self-test (PBKDF2-HMAC-SHA512 x 2048) runs deep on the
# main stack and, with interrupt frames landing on top, about half of all
# Elecrow-5 boots died with a hardware stack-protection fault (Guru
# Meditation, task "main", mid-selftest) before ever reaching the display.
# 20 KB bought that code an ample margin.
#
# 0.2.0-m4a raised it again, and this one was found the same way: on hardware,
# as a stack-protection fault. The sealing engine's mount and format run the
# whole key ladder - HKDF over HMAC-SHA256 over the generic RustCrypto stack,
# then Argon2id, then ChaCha20-Poly1305 - and at the dev profile's opt-level
# "z" that chain nests deeply with large frames. It died 108 bytes past the
# guard inside hmac::utils::get_der_key, i.e. it needed only slightly more than
# 20 KB but it needed it. Guessing a new number would have been the same mistake
# twice, so the value below is set from the MEASURED high-water mark that the
# firmware now prints at every boot ("main task stack: N bytes free of M");
# see docs/plan-0.2.0/MEASUREMENTS.md for the reading this was taken from.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=49152
# 1 ms tick so std::thread::sleep has 1 ms granularity (default is 100 Hz).
CONFIG_FREERTOS_HZ=1000

# --- I2C (0.1.0-m2) ----------------------------------------------------------
# The image links BOTH i2c drivers: esp-idf-hal (via esp-idf-svc) references
# the legacy driver/i2c.h symbols, while our GT911 touch path uses the new
# i2c_master API. The legacy driver's startup constructor abort()s when it
# sees the new driver linked - before app_main, boot-looping the board. We
# never install the legacy driver at runtime, so skipping the link-time check
# is safe; IDF provides this option for exactly this situation.
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y

# --- PSRAM (0.1.0-m2) --------------------------------------------------------
# Both boards use the ESP32-P4NRW32 (32 MB in-package PSRAM). The panel
# drivers allocate the framebuffer from this heap, so display work needs it.
# Speed combination is Waveshare's own proven config (their esp_lcd_st7703
# test app): 200 MHz PSRAM clock, which IDF gates behind the experimental
# features flag. XIP from PSRAM + 256 KB L2 cache with 128 B lines per the
# Waveshare BSP examples - code/rodata execute from PSRAM, freeing internal
# RAM and keeping the display stream from starving flash cache. Proven on
# both boards' rev v1.3 silicon (same package).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# --- microSD FatFs long file names (0.2.0) ------------------------------------
# Without LFN, FatFs is 8.3-only: a signed PSBT cannot be named and desktop-written
# cards list as mangled stems, so sd::mount refuses to mount at all (LONG_NAMES).
# CONFIG_FATFS_LFN_NONE is the IDF default, so until this block existed every build
# refused every card before it powered the slot.
#
# Shared defaults, not a board overlay: reading a card is a product capability that
# the whole 0.2.0 signing path depends on regardless of which panel is attached, and
# the overlays are reserved for what is genuinely per-board (flash size, panel
# errata). A board that could not read cards would be a different product.
#
# HEAP, not STACK: the 512-byte (FF_MAX_LFN+1)*2 UTF-16 working buffer is taken
# transiently from the heap per FatFs call instead of the main task stack, which
# has faulted twice before (see ESP_MAIN_TASK_STACK_SIZE above).
#
# MAX_LFN and CODEPAGE are the IDF defaults, pinned so a default change upstream
# cannot silently narrow what a coordinator may name a file. 437 also keeps the
# ~480 kB CODEPAGE_DYNAMIC tables out of a 4 MiB app partition. Non-ASCII names
# are refused by notyas_wallet::sd::Name, so the codepage never decides anything
# security-relevant; it only has to exist.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_CODEPAGE_437=y
