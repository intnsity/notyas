# notyas firmware - shared sdkconfig defaults (all boards).
# Board-specific options (flash size only, by policy - nothing in this file
# may name a GPIO or a flash size) live in boards/<board>/sdkconfig.defaults;
# tools/build.ps1 passes both via ESP_IDF_SDKCONFIG_DEFAULTS (later file wins).

# --- Chip revision (make-or-break) -------------------------------------------
# All current dev units (Waveshare 4B and Elecrow CrowPanel Advanced) are
# rev v1.3, i.e. the pre-v3.0 engineering-sample family. IDF v5.5 defaults to
# CONFIG_ESP32P4_REV_MIN_301 (rev >= v3.1); an image built for the v3.x family
# flashes fine on v1.3 silicon but never boots (ROM banner only / boot loop,
# no output). Numbering note: ESP32P4_REV_MIN_1 is rev v0.1 and
# ESP32P4_REV_MIN_100 is rev v1.0 (REV_MIN_FULL = major*100 + minor).
# SELECTS_REV_LESS_V3 caps REV_MAX_FULL at 199, excluding v3.x chips entirely.
# Release builds for production (rev >= v3.1) hardware MUST revisit this.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# --- Logging -----------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- FreeRTOS / std runtime --------------------------------------------------
# Rust needs a bigger main task stack than the C default (3.5 KB). 8000 proved
# MARGINAL: the boot self-test (PBKDF2-HMAC-SHA512 x 2048) runs deep on the
# main stack and, with interrupt frames landing on top, about half of all
# Elecrow-5 boots died with a hardware stack-protection fault (Guru
# Meditation, task "main", mid-selftest) before ever reaching the display.
# 20 KB buys the same code an ample margin; internal SRAM has hundreds of KB
# free and the cost is invisible next to the 32 MB PSRAM heap.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20480
# 1 ms tick so std::thread::sleep has 1 ms granularity (default is 100 Hz).
CONFIG_FREERTOS_HZ=1000

# --- I2C (0.1.0-m2) ----------------------------------------------------------
# The image links BOTH i2c drivers: esp-idf-hal (via esp-idf-svc) references
# the legacy driver/i2c.h symbols, while our GT911 touch path uses the new
# i2c_master API. The legacy driver's startup constructor abort()s when it
# sees the new driver linked - before app_main, boot-looping the board. We
# never install the legacy driver at runtime, so skipping the link-time check
# is safe; IDF provides this option for exactly this situation.
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y

# --- PSRAM (0.1.0-m2) --------------------------------------------------------
# Both boards use the ESP32-P4NRW32 (32 MB in-package PSRAM). The panel
# drivers allocate the framebuffer from this heap, so display work needs it.
# Speed combination is Waveshare's own proven config (their esp_lcd_st7703
# test app): 200 MHz PSRAM clock, which IDF gates behind the experimental
# features flag. XIP from PSRAM + 256 KB L2 cache with 128 B lines per the
# Waveshare BSP examples - code/rodata execute from PSRAM, freeing internal
# RAM and keeping the display stream from starving flash cache. Proven on
# both boards' rev v1.3 silicon (same package).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
